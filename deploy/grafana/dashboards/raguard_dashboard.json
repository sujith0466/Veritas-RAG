{
  "title": "RAGuard Executive Dashboard",
  "panels": [
    {
      "title": "Total API Requests",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(raguard_http_requests_total[5m]))"
        }
      ]
    },
    {
      "title": "P95 Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(raguard_http_request_duration_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "title": "Token Consumption",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(raguard_tokens_consumed_total[1h])) by (tenant_id)"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "refresh": "10s"
}
