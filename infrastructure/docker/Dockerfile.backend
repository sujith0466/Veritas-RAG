# syntax=docker/dockerfile:1
# RAGuard AI — Multi-Stage Backend Dockerfile
# Stages: base -> dependencies -> dev (default target) | prod

# ── Stage 1: Base Runtime Environment ──────────────────────────────────────────
FROM python:3.12-slim-bookworm AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app"

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ── Stage 2: Dependencies Builder ──────────────────────────────────────────────
FROM base AS dependencies

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv && pip install --no-cache-dir --upgrade pip wheel setuptools

WORKDIR /build
COPY requirements/base.txt requirements/dev.txt requirements/
RUN pip install --no-cache-dir -r requirements/dev.txt

# ── Stage 3: Development Environment (Default Target) ──────────────────────────
FROM base AS dev

COPY --from=dependencies /opt/venv /opt/venv

RUN groupadd -g 10001 raguard && \
    useradd -u 10001 -g raguard -s /bin/bash -m raguard && \
    mkdir -p /app/backend /app/scratch /tmp/loki && \
    chown -R 10001:10001 /app /tmp/loki

WORKDIR /app
COPY --chown=10001:10001 alembic.ini ./
COPY --chown=10001:10001 backend/ ./backend/

USER 10001

EXPOSE 8000

HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=5 \
    CMD curl -f http://localhost:8000/api/v1/health/live || exit 1

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

# ── Stage 4: Production Target ─────────────────────────────────────────────────
FROM base AS prod

COPY --from=dependencies /opt/venv /opt/venv

RUN groupadd -g 10001 raguard && \
    useradd -u 10001 -g raguard -s /bin/bash -m raguard && \
    mkdir -p /app/backend /app/scratch /tmp && \
    chown -R 10001:10001 /app /tmp

WORKDIR /app
COPY --chown=10001:10001 alembic.ini ./
COPY --chown=10001:10001 backend/ ./backend/

USER 10001

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health/ready || exit 1

CMD ["gunicorn", "-w", "4", "-k", "uvicorn.workers.UvicornWorker", "backend.main:app", "--bind", "0.0.0.0:8000", "--access-logfile", "-", "--error-logfile", "-"]
