# syntax=docker/dockerfile:1
# RAGuard AI — Multi-Stage Frontend Dockerfile
# Stages: base -> dev (default target) | prod-build -> prod

# ── Stage 1: Base Environment ──────────────────────────────────────────────────
FROM node:20-slim AS base

WORKDIR /app/frontend

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ── Stage 2: Development Environment (Default Target) ──────────────────────────
FROM base AS dev

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

EXPOSE 5173

HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=5 \
    CMD curl -f http://localhost:5173 || exit 1

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]

# ── Stage 3: Production Static Asset Builder ───────────────────────────────────
FROM base AS prod-build

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
ARG VITE_API_BASE_URL=/api
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    NODE_ENV=production

RUN npm run build

# ── Stage 4: Production Nginx Server ───────────────────────────────────────────
FROM nginx:1.27-alpine AS prod

RUN addgroup -g 10001 raguard && \
    adduser -D -u 10001 -G raguard raguard && \
    mkdir -p /var/cache/nginx /var/run /var/log/nginx && \
    chown -R raguard:raguard /var/cache/nginx /var/run /var/log/nginx /usr/share/nginx/html

COPY --from=prod-build /app/frontend/dist /usr/share/nginx/html
COPY infrastructure/nginx/nginx.conf /etc/nginx/nginx.conf
COPY infrastructure/nginx/default.conf /etc/nginx/conf.d/default.conf

USER 10001

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:80/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
