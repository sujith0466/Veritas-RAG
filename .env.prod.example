# ─── Production Environment Variables ─────────────────────────────────────
# Replace placeholder values securely using a Secret Manager in CI/CD.

ENVIRONMENT=production
SECRET_KEY=<INSERT_SECURE_KEY_HERE>

DATABASE_URL=postgresql+asyncpg://raguard:<PASSWORD>@<DB_HOST>:5432/raguard_prod
POSTGRES_USER=raguard
POSTGRES_PASSWORD=<PASSWORD>
POSTGRES_DB=raguard_prod

REDIS_URL=redis://<REDIS_HOST>:6379/0
QDRANT_URL=http://<QDRANT_HOST>:6333

OPENAI_API_KEY=<INSERT_OPENAI_KEY>
OPENAI_MODEL=gpt-4o
LLM_PRIORITY_LIST=openai

DLP_ENABLED=true
AUDIT_LOG_ENABLED=true
METRICS_ENABLED=true
LOG_LEVEL=INFO
RETRY_ENABLED=true
REFLECTION_ENABLED=true
