# ============================================================
# RAGuard AI — Master Environment Variables Template (.env.example)
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets to Git.
# This file (.env.example) is safe to commit — it contains NO secrets.
# ============================================================

# ── Application Identity & Runtime Mode ─────────────────────────────────────────
APP_NAME="RAGuard AI"
APP_VERSION="1.0.0"
# Options: development | testing | staging | production
APP_ENVIRONMENT=development
APP_DEBUG=true
# Minimum 32 characters. Generate with: openssl rand -hex 32
APP_SECRET_KEY=CHANGE_ME_generate_a_32_char_random_secret_key_here

# ── Server Configuration ────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1
SERVER_RELOAD=true

# ── Docker Compose Container Variables ──────────────────────────────────────────
# Used by PostgreSQL, Redis, and Qdrant containers at initialization
POSTGRES_DB=raguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
REDIS_PASSWORD=
QDRANT_API_KEY=

# ── Database (PostgreSQL via SQLAlchemy & Alembic) ──────────────────────────────
# Async URL for SQLAlchemy (runtime) - inside Docker Compose use host 'postgres'
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/raguard
# Sync URL for Alembic (migrations only)
ALEMBIC_DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/raguard
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
# Set to true only during development to see SQL queries
DATABASE_ECHO=false

# ── Redis & Celery Task Queue ───────────────────────────────────────────────────
# Inside Docker Compose use host 'redis'
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
# Redis URL for Celery broker (separate DB index)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Qdrant Vector Database ──────────────────────────────────────────────────────
# Inside Docker Compose use host 'qdrant'
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=false
# Default collection name prefix (e.g., raguard_documents_{tenant_id})
QDRANT_COLLECTION_PREFIX=raguard

# ── Supabase Authentication ───────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# CAUTION: Service role key has admin access. NEVER expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Get from: Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWKS_URL=

# ── AI Providers (OpenRouter & Google Gemini) ───────────────────────────────────
# Provider selection and priority chain
LLM_PROVIDER_PRIORITY=openrouter,gemini
PRIMARY_LLM_PROVIDER=openrouter
FALLBACK_LLM_PROVIDER=gemini

# OpenRouter AI
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_LITE_MODEL=anthropic/claude-3-haiku
OPENROUTER_MAX_OUTPUT_TOKENS=2048
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_REQUEST_TIMEOUT=60

# Google Gemini AI
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_LITE_MODEL=gemini-2.0-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.1
GEMINI_REQUEST_TIMEOUT=60

# ── Frontend Environment (Vite injected variables) ──────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_APP_ENV=development

# ── Security & CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
# Comma-separated list of allowed hosts (empty = allow all in dev)
ALLOWED_HOSTS=localhost,127.0.0.1
# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60
# Max file upload size in bytes (default: 50MB)
MAX_UPLOAD_SIZE_BYTES=52428800

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Options: json | console (use json in staging/production)
LOG_FORMAT=console
# Log request/response details (can be verbose)
LOG_REQUESTS=true

# ── Observability (OpenTelemetry) ─────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=raguard-ai
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Sampling rate: 1.0 = 100% of traces, 0.1 = 10%
OTEL_TRACES_SAMPLER_ARG=1.0

# ── Feature Flags ─────────────────────────────────────────────────────────────
# All features default OFF. Enable explicitly per environment.
ENABLE_RETRY_ENGINE=false
ENABLE_REFLECTION=false
ENABLE_ANSWER_VALIDATION=false
ENABLE_KNOWLEDGE_HEALTH=false
ENABLE_EVALUATION=false
ENABLE_ANALYTICS=false
ENABLE_MONITORING=false
ENABLE_OTEL_TRACING=false

# ── Testing ───────────────────────────────────────────────────────────────────
# Only used when APP_ENVIRONMENT=testing
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/raguard_test
TEST_REDIS_DB=15
