# ─── Core ────────────────────────────────────────────────────────────────
ENVIRONMENT=development           # development | staging | production
SECRET_KEY=change-me-to-a-secure-random-string
DEBUG=false

# ─── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://raguard:secret@localhost:5432/raguard_db
POSTGRES_DB=raguard_db
POSTGRES_USER=raguard
POSTGRES_PASSWORD=secret
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant ──────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── LLM Providers ───────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
LLM_PRIORITY_LIST=openai,anthropic

# ─── Security ────────────────────────────────────────────────────────────
DLP_ENABLED=true
AUDIT_LOG_ENABLED=true

# ─── Observability ───────────────────────────────────────────────────────
OTLP_ENDPOINT=
METRICS_ENABLED=true
LOG_LEVEL=INFO

# ─── Feature Flags ───────────────────────────────────────────────────────
RETRY_ENABLED=true
REFLECTION_ENABLED=true
CHAOS_ENABLED=false
