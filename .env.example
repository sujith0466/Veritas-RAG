# ─── Core ────────────────────────────────────────────────────────────────
ENVIRONMENT=development           # development | staging | production
SECRET_KEY=change-me-to-a-secure-random-string
DEBUG=false

# ─── Authentication (V2) ─────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ────────────────────────────────────────────────────────────
USE_PGBOUNCER=false
PGBOUNCER_URL=postgresql+asyncpg://raguard:secret@localhost:6432/raguard_db
DATABASE_URL=postgresql+asyncpg://raguard:secret@localhost:5432/raguard_db
POSTGRES_DB=raguard_db
POSTGRES_USER=raguard
POSTGRES_PASSWORD=secret
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant ──────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── LLM Providers ───────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct,openai/gpt-4o-mini,google/gemini-2.5-flash
OPENROUTER_LITE_MODELS=openai/gpt-4o-mini,anthropic/claude-3-haiku
GEMINI_API_KEY=AIza...
LLM_PRIORITY_LIST=openrouter,gemini
# ─── Security ────────────────────────────────────────────────────────────
DLP_ENABLED=true
AUDIT_LOG_ENABLED=true

# ─── Observability ───────────────────────────────────────────────────────
OTLP_ENDPOINT=
METRICS_ENABLED=true
LOG_LEVEL=INFO

# ─── Feature Flags ───────────────────────────────────────────────────────
RETRY_ENABLED=true
REFLECTION_ENABLED=true
CHAOS_ENABLED=false

# --- QA Bootstrap ---
QA_EMAIL=your_qa_email@example.com
QA_PASSWORD=your_secure_password_here
